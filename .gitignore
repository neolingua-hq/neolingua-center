# OS
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Desktop.ini
ehthumbs.db
*~

# Editors
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace
.vscode/*
!.vscode/extensions.json

# Node / Vite
node_modules/
dist/
dist-ssr/
.vite/
coverage/
.vitest/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Env and secrets (never commit keys)
.secrets/
.env
.env.*
!.env.example
*.pem
*.p12
*.pfx

# Rust / Cargo
src-tauri/target/
**/*.rs.bk

# Bundled native tools (fetched by npm run fetch-binaries)
src-tauri/binaries/ffmpeg-*
src-tauri/binaries/ffprobe-*
src-tauri/binaries/whisper-cli-*
src-tauri/binaries/.whisper-src/
src-tauri/resources/whisper/*.bin
src-tauri/resources/whisper/*.partial

# Local signed updater keypair
src-tauri/*.key
src-tauri/*.key.pub

# Installer artifacts from a local tauri build
*.dmg
*.AppImage
*.exe
*.msi
*.nsis.zip
*.app.tar.gz
*.app.tar.gz.sig

# Local-only release publish helpers (not versioned)
scripts/publish-downloads.mjs
