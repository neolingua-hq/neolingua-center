{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Neolingua Center",
  "mainBinaryName": "Neolingua Center",
  "version": "1.0.0-beta.2",
  "identifier": "fr.neolingua.center",
  "build": {
    "beforeDevCommand": "npm run fetch-binaries && npm run dev",
    "devUrl": "http://localhost:1422",
    "beforeBuildCommand": "npm run fetch-binaries && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Neolingua Center",
        "width": 1100,
        "height": 760,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/ffmpeg", "binaries/ffprobe", "binaries/whisper-cli"],
    "resources": {
      "resources/whisper/": "whisper/",
      "viewer/": "viewer/"
    },
    "macOS": {
      "bundleName": "Neolingua Center",
      "infoPlist": "./Info.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI4RjgyMEIxNTFGNjM4RkQKUldUOU9QWlJzU0Q0S0ZHZ3JoSDV2aDdibnZuTEVKWllVOGg0bW1MdDVqMElPQjgwMUVyN1pleWIK",
      "endpoints": [
        "https://github.com/neolingua-hq/neolingua-center/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
